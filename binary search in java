import java.util.*;
 public class def{
public static void main(String[] args){
int[] arr={5,10,15,21,30};
int x=66;
int ans =binarySearch(arr,x);
System.out.print(ans);

}
 static int binarySearch(int[] arr,int x) {
int start=0;; int end=arr.length-1;

while(start<=end){
int mid=start +(end-start)/2;
if(x<arr[mid]){
    end=mid-1;
}
else if(x>arr[mid]){
    start=mid+1;
}
else {
    return mid;
}
}
return -1;
}
}
